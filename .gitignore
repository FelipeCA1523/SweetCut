# --- Subidas del admin (no versionadas) ---
# Las imágenes subidas y sus miniaturas viven en assets/uploads/
assets/uploads/*
!assets/uploads/.htaccess

# --- Config local / entorno ---
config/.env
*.env.local

# --- Config local del catálogo (número de WhatsApp real NO se sube) ---
js/config.local.js

# --- Composer / dependencias PHP (si algún día se usa) ---
/vendor/
composer.lock

# --- Tests / PHPUnit (si algún día se usa) ---
/phpunit.xml
/.phpunit.cache/
.phpunit.result.cache

# --- Logs y temporales ---
*.log
*.tmp
*.cache

# --- Backups de la base de datos ---
/backups/
*.sql.bak

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-*
*.code-workspace

# --- Copias de seguridad de editores ---
*~
*.swp
*.swo
*.orig
*.bak